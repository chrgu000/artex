# Docker 部署配置（复制为 .env）
# ARTEX_TAG 是本仓库 docker compose 构建出的本地镜像标签，默认 local。
# 不再拉取上游 autumn27/artex（该镜像已不可用）。
ARTEX_TAG=local
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM（二选一或都填；也可留空，之后在界面里配置）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
